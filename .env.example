# Copy to .env (already gitignored) and edit. Nothing else is needed to run the app.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL is the intended database. Leave DATABASE_URL out to use a local SQLite file
# instead, which is handy for a quick look at the UI.
DATABASE_URL=postgresql://society_ca:society_ca@localhost:5432/society_ca

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
