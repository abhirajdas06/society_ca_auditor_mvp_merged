# Copy to .env for local use. Never commit .env.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
# Local PostgreSQL (recommended). Omit DATABASE_URL to fall back to SQLite for quick UI work.
DATABASE_URL=postgresql://society_ca:society_ca@localhost:5432/society_ca
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Production only
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
